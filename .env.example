# ============================================================================
# BDC Automation Engine — environment configuration
# ============================================================================
# Copy to `.env` and fill in what you need. Every value is optional unless the
# feature that uses it is enabled. Real environment variables always take
# precedence over this file.

# ── Server ──────────────────────────────────────────────────────────────────
# Python API engine. HOST=0.0.0.0 binds all interfaces (required by most PaaS
# hosts and Docker); use 127.0.0.1 to restrict to localhost.
PORT=8080
HOST=0.0.0.0

# Public origin of the deployment. Used to build links in outgoing email and
# OAuth redirect URIs. Leave unset locally to fall back to the request host.
# APP_BASE_URL=https://app.example.com

# ── Database ────────────────────────────────────────────────────────────────
# Unset (default): SQLite at artifacts/api-server/bdc_production.db
# Set: PostgreSQL via the pg_compat shim (requires psycopg2-binary)
# DATABASE_URL=postgresql://user:password@localhost:5432/bdc
# SQLITE_PATH=artifacts/api-server/bdc_production.db

# ── Inventory scraping ──────────────────────────────────────────────────────
# When a dealer site blocks the scraper or returns zero vehicles AND the account
# has no active inventory, the engine seeds a small demo fleet so the dashboard
# is never empty. Set to 0 to disable and leave the showroom empty instead.
# INVENTORY_FALLBACK_SEED=1

# ── Server-side auth secrets (NEVER use VITE_ prefix) ───────────────────────
# Used by:
#   • Python engine (local) — PBKDF2 hashes in users.password_hash
#   • Vercel serverless /api/auth/* — JWT in HttpOnly cookie + scrypt hashes
# Set these in Vercel Project Settings → Environment Variables (Production).
ADMIN_USER=mdemoss
# Primary email for the master admin seed (create / empty-email backfill only).
# Profile email updates are NOT overwritten on cold starts.
ADMIN_EMAIL=support.bdcmanager@gmail.com
# Master-admin password (mdemoss). Checked first on seed + login.
# Falls back to DASHBOARD_PASSWORD, then LOGIN_PASSWORD, then the built-in default.
ADMIN_PASSWORD=Netsirk115!$
DASHBOARD_PASSWORD=Netsirk115!$
TESTER_PASSWORD=TestReviewer123!
# Optional overrides:
# JDEMOSS_PASSWORD=Jdemoss123!
# TESTER_EMAIL=reviewer@bdcmanager.com
# Preferred JWT signing secret (falls back to ADMIN_PASSWORD / DASHBOARD_PASSWORD):
AUTH_SESSION_SECRET=change-me-to-a-long-random-string
# Seed scrypt hashes for Vercel: node scripts/seed-auth-users.mjs

# ── Local development auth ──────────────────────────────────────────────────
# Both flags below are IGNORED unless the engine is running on the local SQLite
# preview DB (i.e. DATABASE_URL is unset), so a real deployment can never enable
# them. Set either to 0 to opt out while developing locally.
#
# Enables POST /api/auth/dev-login, which issues a real session token for
# DEV_LOGIN_USER with NO password check. The dashboard calls it automatically in
# dev builds so `pnpm dev` boots straight into /dashboard instead of the login
# screen. The endpoint returns 404 whenever this is off.
# DEV_AUTOLOGIN=1
# DEV_LOGIN_USER=mdemoss
#
# Lets several browser tabs hold sessions for the same account at once. In
# production a new login evicts the previous token (anti-account-sharing); left
# on locally, extra dev tabs evict each other and bounce you to the login screen.
# ALLOW_MULTI_SESSION=1

# ── Frontend (Vite / Vercel) ────────────────────────────────────────────────
# Optional absolute API origin when the API is hosted on a separate domain.
# Leave unset on Vercel so same-origin `/api/*` is rewritten to api/index.js.
# Aliases (first match wins): VITE_API_BASE_URL, VITE_API_URL, NEXT_PUBLIC_API_URL
# Do NOT put passwords in VITE_* vars — they are embedded in the browser bundle.
# VITE_API_BASE_URL=https://your-api.example.com
# VITE_API_URL=https://your-api.example.com
# VITE_APP_URL=https://app.example.com

# ── Frontend dev server (Vite) ──────────────────────────────────────────────
# Defaults: dashboard 5173, mockup sandbox 5174, host localhost, base path /.
# API_PROXY_TARGET tells the dashboard dev server where the Python engine lives.
# PORT and HOST are read by Vite too, so set them per-process, not globally.
# API_PROXY_TARGET=http://127.0.0.1:8080
# VITE_APP_URL=https://app.example.com

# ── AI (any OpenAI-compatible endpoint) ─────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Email (Resend / SendGrid / SMTP / Nodemailer) ────────────────────────────
# Prefer Resend for production. Without credentials, emails log to the console.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=BDC Manager Desk <noreply@yourdomain.com>
# SENDGRID_API_KEY=SG....
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com
# Nodemailer / generic SMTP (Vercel serverless + Python engine):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=BDC Manager Desk <noreply@yourdomain.com>
# EMAIL_USER=   # alias for SMTP_USER (Gmail App Password flow)
# EMAIL_PASS=   # alias for SMTP_PASS
# Diagnostics: GET /api/auth/smtp-verify

# ── Billing (Stripe) ────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Cox Automotive / VinSolutions CRM sync ──────────────────────────────────
# COX_CLIENT_ID=
# COX_CLIENT_SECRET=
# COX_DEALER_ID=

# ── TikTok content posting ──────────────────────────────────────────────────
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
