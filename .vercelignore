# Keep the Vercel deploy payload lean and Node-only.
# Python BDC engine / Playwright / local DBs are not used on Vercel serverless.

requirements.txt
pyproject.toml
main.py
**/*.py
**/*.pyc
**/__pycache__/
**/*.db
**/*.db-*
artifacts/api-server/bdc_production.db
artifacts/api-server/playwright_scraper.py
artifacts/api-server/scraper/
artifacts/api-server/express-entry/
artifacts/mockup-sandbox/
artifacts/bdc-dashboard/tests/
**/node_modules/
**/.git/
**/.venv/
**/venv/
**/.pythonlibs/
tmp/
.cache/
